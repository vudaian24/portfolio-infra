# Copy to secrets.auto.tfvars (git-ignored), set the value, then chmod 600 secrets.auto.tfvars.
# Terraform loads it on every plan and apply in envs/prod. Placeholder only: never commit the real token.

# Cloudflare API token: the zone permissions of modules/dns on anvd.io.vn. While admin_access_enabled = false
# it needs nothing else (modules/admin_access/README.md lists the account permissions it adds).
cloudflare_api_token = "<CLOUDFLARE_API_TOKEN>"
