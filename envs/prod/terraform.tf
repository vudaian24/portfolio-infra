terraform {
  # Write-only arguments (ssm value_wo) need >= 1.11; use_lockfile needs >= 1.10
  required_version = ">= 1.11"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }

    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.0"
    }
  }
}
